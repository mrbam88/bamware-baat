# Backend endpoints — bring your own. Unreachable endpoints degrade to the
# in-app error toast; the UI still boots.
EXPO_PUBLIC_AUTH_URL=https://auth.example.com
EXPO_PUBLIC_DATING_URL=https://api.example.com

# Public (baked into builds). Leave unset to disable Sentry.
# EXPO_PUBLIC_SENTRY_DSN=

# Google SSO client IDs (public; from Google Cloud console).
# Unset = Google button degrades to an "isn't available yet" toast, no crash.
# When provisioned, also replace the iosUrlScheme placeholder in app.json
# with the reversed iOS client ID.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- Names only below; real values live in your shell / CI secrets.
# --- Never commit values. See docs/RELEASING.md.

# App Store Connect API key (native-rail submits: fastlane pilot)
# ASC_KEY_ID=
# ASC_ISSUER_ID=
# ASC_KEY_P8_B64=            # base64 < AuthKey_XXXX.p8

# Google Play service account (native-rail submits: fastlane supply)
# SUPPLY_JSON_KEY=           # path to service-account.json (outside the repo)

# Maestro E2E test credentials (a seeded account on your backend)
# MAESTRO_TEST_EMAIL=
# MAESTRO_TEST_PASSWORD=
